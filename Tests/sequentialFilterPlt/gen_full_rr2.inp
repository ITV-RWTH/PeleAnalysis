# Two levels, ref_ratio 2, level 1 covers the whole domain (no coarse/fine interface)
amr.n_cell = 16 16 16
amr.max_grid_size = 16
amr.max_level = 1
amr.ref_ratio = 2
amr.blocking_factor = 4
amr.n_error_buf = 1
geometry.coord_sys = 0
geometry.prob_lo = 0.0 0.0 0.0
geometry.prob_hi = 1.0 1.0 1.0
geometry.is_periodic = 0 0 0
plotfile_name = plt_full_rr2
amr.refinement_indicators = all
amr.all.in_box_lo = 0.0 0.0 0.0
amr.all.in_box_hi = 1.0 1.0 1.0
field.names = sine_f sph cst
sine_f.type = sine
sine_f.frequency = 2.0 1.0 3.0
sine_f.phase = 0.1 0.2 0.3
sine_f.amplitude = 1.0
sine_f.offset = 0.0
sph.type = sphere_smooth
sph.center = 0.45 0.5 0.55
sph.radius = 0.2
sph.value_inside = 1.0
sph.value_outside = 0.0
sph.smooth_width = 0.05
cst.type = constant
cst.value = 3.5
