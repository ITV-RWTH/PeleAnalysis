infile = str_3d
is_per = 1 1 1
domain_size = 1.0 1.0 1.0
avgComps = q
intComps = q
writeSurface = 1
writeBasic = 0
writeTecplotSurfaceFromStream = 1
writeStreamsToMatlab = 1
