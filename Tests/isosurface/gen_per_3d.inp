# The field of gen_per_2d.inp extruded in z over [0, 0.25], periodic in all
# directions: the iso surface is the iso line of gen_per_2d.inp times 0.25.
amr.n_cell = 64 64 16
amr.max_grid_size = 16
amr.max_level = 0

geometry.coord_sys = 0
geometry.prob_lo = 0.0 0.0 0.0
geometry.prob_hi = 1.0 1.0 0.25
geometry.is_periodic = 1 1 1

plotfile_name = plt_iso_per_3d

# sin(0 z + pi/2) = 1: no z dependence
field.names = c
c.type = sine
c.frequency = 1.0 1.0 0.0
c.phase = 0.5890486225480862 -0.9817477042468103 1.5707963267948966
c.amplitude = 1.0
c.offset = 0.0
