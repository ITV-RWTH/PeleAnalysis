# Test 6: do_conditioning=2 — effective conditioning value is c(1-c)
# Requires: plt_jpdf_A (generated with generate_plt_A.inp)
#
# cVar=1 selects var_sine (continuous values in ~[0,1]) as the conditioning
# variable. do_conditioning=2 forces norm_cVal=1 automatically.
#
# cVal = var_sine * (1 - var_sine), range [0, 0.25]
# Normalised by cNormMax=0.25: norm_cVal in [0, 1]
# cMin=0.5 retains only cells where norm_cVal >= 0.5, i.e.,
#   var_sine * (1 - var_sine) >= 0.125, i.e., var_sine in roughly [0.15, 0.85].
#
# Expected: JPDF bins for var_sine near 0 or 1 (the tails) are zero because
# those cells are excluded by the conditioning mask.
# After the normalization fix, sum(PDF) = 1.0.

infile          = plt_jpdf_A
vars            = var_plane var_sine
nBins           = 16
outSuffix       = _test6
do_conditioning = 2
cVar            = 1
cNormMin        = 0.0
cNormMax        = 0.25
cMin            = 0.5
cMax            = 1.0

output_plotfile = 1
